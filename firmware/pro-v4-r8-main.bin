  p=end;}
 var ord=[2,3,0,1];ev.sort(function(x,y){return x.k-y.k||ord[x.y]-ord[y.y];});var tp=500000,lt=0,ts=0;
 for(var i=0;i<ev.length;i++){ts+=(ev[i].k-lt)*tp/div/1e6;lt=ev[i].k;ev[i].t=ts;if(ev[i].y==2)tp=ev[i].tp;}
