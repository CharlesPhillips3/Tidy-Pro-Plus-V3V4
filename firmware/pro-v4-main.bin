   enc.configure({codec:'opus',sampleRate:48000,numberOfChannels:ch,bitrate:SHRINK_KBPS*1000,opus:{frameDuration:20000,application:'audio'}});
   var CH=48000,chans=[];for(var k=0;k<ch;k++)chans.push(buf.getChannelData(k));
