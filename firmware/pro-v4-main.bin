 if(op=='L')fetch(R+'/list?board='+B).then(chk).then(function(j){var s='L\tok\t'+j.used+'\t'+j.max;j.files.forEach(function(f){s+='\n'+f.name.replace(/[^\x20-\x7e]/g,'_')+'\t'+f.size;});rep13(s);}).catch(err);
