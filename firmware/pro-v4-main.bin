function cloudNext(R,B){var f=dropQ.shift();if(!f)return;var nm=f.name.replace(/[^A-Za-z0-9 ._()-]/g,'_').slice(-80).replace(/^\./,'_');
 if(f.size>25*1048576){note(nm+' is over 25 MB - skipped.',6000);cloudNext(R,B);return;}
