 fetch(R.replace(/\/+$/,'')+'/file?board='+B+'&name='+encodeURIComponent(nm),{method:'PUT',body:f}).then(function(r){return r.json().then(function(j){if(!r.ok||j.error)throw j.error||('error '+r.status);});})
