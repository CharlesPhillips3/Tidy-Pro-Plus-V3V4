function midiPump(){var m=midiCur;if(!m||m.paused)return;var now=m.ctx.currentTime;
 while(m.i<m.ev.length&&m.ev[m.i].t+m.t0<now+0.7){var e=m.ev[m.i++],at=Math.max(now,e.t+m.t0);
