   for(var sg=0;sg<cnt;sg++){var y=d[o]|d[o+1]<<8,a=d[o+2],len=d[o+3];o+=4;var oe=o+len;
    if(bpp==1){var p=y*640+a*8;for(;o<oe;o++){var b=d[o];for(var i=7;i>=0;i--)px[p++]=pal[b>>i&1];}}
