 var n=decodeURIComponent((v.split('path=')[1]||v).split('&')[0]).split('/').pop().replace(/\.[^.]+$/,''),a='TidyOS Pro',t=n,i=n.indexOf(' - ');
 if(i>0){a=n.slice(0,i);t=n.slice(i+3);}
