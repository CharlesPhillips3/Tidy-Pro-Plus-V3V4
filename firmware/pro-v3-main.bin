   dirty=true;}
  else if(d[0]==8){var t=new TextDecoder().decode(d.subarray(1)).split('\n');ver=t[0];upBase=parseInt(t[1])||0;upAt=Date.now();}
  else if(d[0]==9)media(new TextDecoder().decode(d.subarray(1)));
