  var len=n==46||n>=49?0.3:hat?0.05:0.15;g.gain.setValueAtTime(0.5*e.v/127,at);g.gain.exponentialRampToValueAtTime(0.001,at+len);s.start(at);s.stop(at+len+0.02);return;}
