   if(f>=1e-4){c='X';m=1e-4;}else if(f>=1e-5){c='M';m=1e-5;}else if(f>=1e-6){c='C';m=1e-6;}else if(f>=1e-7){c='B';m=1e-7;}fcSend('xray',c+(f/m).toFixed(1));}).catch(function(){});}
